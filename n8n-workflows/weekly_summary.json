{
  "name": "Weekly Risk Summary",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Every Monday 08:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SERVER_BASE_URL }}/summary/generate",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "period",
              "value": "weekly"
            },
            {
              "name": "token",
              "value": "={{ $env.SUMMARY_ACCESS_TOKEN }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 120000
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000002",
      "name": "POST /summary/generate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-status",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ok",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000003",
      "name": "Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst url = item.json.url ?? '(no url)';\nconsole.log(`[weekly-summary] report ready: ${url}`);\nreturn [{ json: { url } }];"
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000004",
      "name": "Log success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 220]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst err = JSON.stringify(item.json);\nconsole.error(`[weekly-summary] generation failed: ${err}`);\nreturn [{ json: { error: err } }];"
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000005",
      "name": "Log error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 400]
    }
  ],
  "connections": {
    "Every Monday 08:00 UTC": {
      "main": [
        [
          {
            "node": "POST /summary/generate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /summary/generate": {
      "main": [
        [
          {
            "node": "Success?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Success?": {
      "main": [
        [
          {
            "node": "Log success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "id": "weekly-risk-summary-v1",
  "meta": {
    "note": "Requires env vars SERVER_BASE_URL and SUMMARY_ACCESS_TOKEN set in n8n. Activate after deploying the FastAPI server. Schedule: every Monday 08:00 UTC."
  },
  "tags": ["summary", "weekly", "risk"]
}
