# Copy to .env and fill in. IMPORTANT: keep comments on their OWN lines.
# pydantic-settings does NOT strip inline "KEY=value  # comment" reliably — an
# inline comment gets read as part of the value (and breaks int/Decimal fields).

# === Telegram ===
# Must be a real @BotFather token (format: digits:string, no spaces).
TELEGRAM_BOT_TOKEN=
# generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_URL is AUTO-DERIVED from SERVER_BASE_URL as {SERVER_BASE_URL}/webhook.
# Do NOT set this manually — set SERVER_BASE_URL instead (see below).
# Override here ONLY if your webhook path differs from /webhook.
# TELEGRAM_WEBHOOK_URL=
# fallback for alerts (optional int). Leave commented to default to None;
# do NOT leave it as an empty value (empty string fails int parsing).
# TELEGRAM_MANAGEMENT_CHAT_ID=-1001234567890

# === Supabase ===
SUPABASE_URL=
# service role key, NOT anon
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
SUPABASE_STORAGE_BUCKET=llm-audit

# === LLM ===
OPENROUTER_API_KEY=
LLM_MODEL_TIER2=anthropic/claude-haiku-4-5
LLM_MODEL_SUMMARY=anthropic/claude-sonnet-4-6

# === Whisper (separate from OpenRouter) ===
OPENAI_API_KEY=
# MVP kill-switch: false drains the whisper queue without calling the paid API.
# Set true once the Whisper budget is available.
WHISPER_ENABLED=false
WHISPER_MODEL=whisper-1
WHISPER_POLL_INTERVAL_SECONDS=10
WHISPER_BATCH_SIZE=3
WHISPER_MAX_ATTEMPTS=3

# === Slack ===
# xoxb-...
SLACK_BOT_TOKEN=
# for Events API verification
SLACK_SIGNING_SECRET=
# channel ID for all risk alerts (high, critical, system)
SLACK_CHANNEL_ALERTS=
# channel ID for weekly/monthly reports
SLACK_CHANNEL_REPORTS=

# === Summary / HTML reports ===
# generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# guards POST /summary/generate and GET /reports/... ; MUST set before deploy
SUMMARY_ACCESS_TOKEN=
# public base URL (no trailing slash, no /webhook) — used in report links
SERVER_BASE_URL=https://bot.yourcompany.com

# === Cost limits ===
# circuit breaker
DAILY_LLM_BUDGET_USD=30
WEEKLY_LLM_BUDGET_USD=180

# === Pipeline ===
# 10 minutes
BATCH_PROCESSING_INTERVAL_SECONDS=600
# for priority lane
PRIORITY_SCORE_THRESHOLD=50
# context window for batch
CONTEXT_WINDOW_MINUTES=30
# 7 days
ABANDONED_CHAT_TIMEOUT_HOURS=168

# === Ops Alerts (payment incidents + Argentina holidays) ===
# Master kill-switch. false → neither ops-alerts worker runs.
OPS_ALERTS_ENABLED=false
# RSS feed URL with payment-provider statuses. Sensitive — fill at deploy.
# Empty disables the incidents branch even when OPS_ALERTS_ENABLED=true.
OPS_FEED_URL=
OPS_INCIDENTS_POLL_INTERVAL_SECONDS=600
OPS_FEED_HTTP_RETRIES=3
OPS_FEED_HTTP_RETRY_DELAY_SECONDS=5
OPS_HOLIDAYS_TIMEZONE=Europe/Madrid
OPS_HOLIDAYS_CRON_HOUR=13
OPS_HOLIDAYS_POLL_INTERVAL_SECONDS=900
# max parallel group sends (Telegram rate-limit guard)
OPS_BROADCAST_SEMAPHORE=20

# === Tone of voice (Phase 2 — daily LLM review of manager wording) ===
# Kill switch. Off by default; enable after measuring cost with
# `python scripts/tone_backfill.py --estimate`.
TONE_ANALYSIS_ENABLED=false
LLM_MODEL_TONE=anthropic/claude-haiku-4-5
# per-UTC-day ceiling for the pass (also counted in DAILY_LLM_BUDGET_USD)
TONE_DAILY_BUDGET_USD=2
TONE_MIN_CONFIDENCE=0.7
# a rate shows only after this many judged messages in the period
TONE_MIN_ASSESSED=20
# finished days a tick may reach back for unprocessed chat-days
TONE_BACKFILL_DAYS=7
TONE_POLL_INTERVAL_SECONDS=900

# === Dashboard sign-in ===
# Signing key for the session cookie. Leave empty to derive it from the bot
# token; setting or changing it logs every viewer out.
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_DAYS=90
# Slack member id -> role, applied ONCE when that Slack account finishes
# /register, so a new reader's whole setup is "send /register, paste your id,
# paste the code". The one-time code goes to that Slack DM, so only the account
# owner can redeem an entry. Roles: admin | head | manager | viewer.
# Must be one line of JSON. Real ids belong in .env, never in this file.
REGISTRATION_ROLE_GRANTS={"U01234ABCDE": "admin"}

# === Bot ===
# bot replies language in DM
BOT_DM_LANGUAGE=en
# production / staging / dev
ENVIRONMENT=production
LOG_LEVEL=INFO
