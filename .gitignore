# Supabase local runtime artifacts (CLI-managed; never commit)
supabase/.temp/
supabase/.branches/
supabase/.env

# Non-code project files — kept local, not part of the technical codebase.
# CLAUDE.md (Claude Code working context / project brief) and the .docx manual
# generator are working/meta artifacts, not the bot itself.
CLAUDE.md
scripts/gen_docs.py
scripts/gen_ops_guide.py
scripts/gen_test_guide.py
# Same reason as the three above, plus two of its own: reportlab is NOT a
# declared dependency in pyproject.toml (it only happens to be installed), and
# the script hardcodes C:/Windows/Fonts for Cyrillic glyphs, so it is
# Windows-only. gen_handoff_docs.py IS committed by contrast, because
# python-docx is a declared dep with a mypy override.
scripts/gen_phase2_pdf.py

# Internal spec docs — kept local for now; may become docs/README later
*.docx
Reports overview.pdf
Phase 2 - Manager KPI.pdf

# Handoff / ops spec docs — generated local-only (no secrets, but intentionally
# not committed; see scripts/gen_handoff_docs.py)
OPS_ALERTS.md
PUBLIC_LAYER.md
PHASE2_MANAGER_KPI.md

# Ops workspace — Claude's deployment runbook, scripts, local notes (no secrets,
# but intentionally local-only; fly.toml in root IS committed).
ops/

# Sample / generated test artefacts — local only
tests/gen_sample_report.py
tests/sample_*.html

# Local working files: red-flag dictionary prompt + the GPT output we paste back
red_flag_dictionary*.txt
red_flag_dictionary*.json
# Approved Tier-1 dictionary (leadership-approved data, loaded into the DB; never committed)
red_flag_patterns_dictionary*.txt
red_flag_patterns_dictionary*.json

# Partner-chat archive export: the raw Telegram Desktop HTML dump of 241 partner
# chats — ~106 MB, 12 746 files, real customer conversations plus their photos and
# documents. Imported into the DB by scripts/import_archive.py; the corpus itself
# must never enter git. Without these lines `git add -A` stages 26 738 paths and
# publishes the lot to all three remotes, including the shared team repo — and a
# push cannot be un-published. `__MACOSX/` is the resource-fork junk the zip
# expands alongside it.
AFFS_CHATS/
AFFS_CHATS*.zip
__MACOSX/

# Local copies of the archive risk review (scripts/analyze_archive.py --report):
# real findings quoting partner messages verbatim. The review is meant to be read
# over the password-gated /archive/{token} link, not carried around as a file. No
# .html is tracked anywhere in this repo, so ignoring root-level HTML keeps any
# generated report out by default.
/*.html

# Claude Code machine-local settings (permissions etc.). A shared
# .claude/settings.json may still be committed deliberately.
.claude/settings.local.json

# Report shell build artifact (produced by the Docker node stage, or a local
# `npm run build` copied here). Source lives in frontend/.
/static/
PHASE2_ANALYTICS_SUMMARY.md
Phase 2 Analytics - Summary.pdf
